# Default provider is Gemini, accessed through its OpenAI-compatible endpoint so the
# backend uses one client code path regardless of provider. Get a key from
# https://aistudio.google.com/apikey and put it in .env, never in this file.
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=replace-me
LLM_MODEL=gemini-2.5-flash
LLM_VISION_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=90

# To use an OpenAI-compatible provider instead, override these four:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_VISION_MODEL=gpt-4.1-mini

LABELGUARD_MODE=live
RULES_DIR=rules
UPLOAD_MAX_BYTES=8000000
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/webp
TRACE_DIR=evaluation/traces
