{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LabelGuard evaluation case",
  "type": "object",
  "required": ["case_id", "jurisdiction", "product_category", "difficulty", "label_spec"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^(IN|UK)-[0-9]{3}$"},
    "title": {"type": "string"},
    "jurisdiction": {"type": "string", "enum": ["IN", "UK"]},
    "product_category": {"type": "string", "enum": ["packaged_food"]},
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
    "image": {"type": "string"},
    "context": {
      "type": "object",
      "properties": {
        "imported": {"type": "boolean"},
        "single_ingredient": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "label_spec": {
      "type": "object",
      "required": ["pack", "panels"],
      "properties": {
        "pack": {
          "type": "object",
          "required": ["px_per_cm", "width_cm", "height_cm"],
          "properties": {
            "px_per_cm": {"type": "number"},
            "width_cm": {"type": "number"},
            "height_cm": {"type": "number"},
            "principal_panel_area_cm2": {"type": "number"},
            "largest_surface_area_cm2": {"type": "number"},
            "background": {"type": "string"},
            "rotation_degrees": {"type": "number"},
            "blur_radius": {"type": "number"},
            "noise": {"type": "number"}
          }
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "blocks"],
            "properties": {
              "id": {"type": "string"},
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type"],
                  "properties": {
                    "type": {"type": "string", "enum": ["text", "symbol", "spacer"]},
                    "text": {"type": "string"},
                    "font_px": {"type": "number"},
                    "bold": {"type": "boolean"},
                    "uppercase": {"type": "boolean"},
                    "color": {"type": "string"},
                    "symbol": {"type": "string", "enum": ["veg_green", "nonveg_brown", "fssai_logo"]},
                    "height_px": {"type": "number"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "notes": {"type": "string"}
  }
}
