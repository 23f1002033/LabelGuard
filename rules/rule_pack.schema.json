{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LabelGuard rule pack",
  "type": "object",
  "required": ["jurisdiction", "product_category", "pack_version", "sources", "rules"],
  "properties": {
    "jurisdiction": {"type": "string", "enum": ["IN", "UK"]},
    "jurisdiction_name": {"type": "string"},
    "product_category": {"type": "string", "enum": ["packaged_food"]},
    "pack_version": {"type": "string"},
    "retrieved_on": {"type": "string", "format": "date"},
    "scope_note": {"type": "string"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "name", "url"],
        "properties": {
          "source_id": {"type": "string"},
          "name": {"type": "string"},
          "publisher": {"type": "string"},
          "url": {"type": "string"},
          "retrieved_on": {"type": "string", "format": "date"}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id", "jurisdiction", "category", "requirement", "severity",
          "source_id", "source_reference", "source_excerpt", "applicability",
          "validation_type", "required_facts"
        ],
        "properties": {
          "rule_id": {"type": "string", "pattern": "^RULE-(IN|UK)-FOOD-[0-9]{3}$"},
          "jurisdiction": {"type": "string", "enum": ["IN", "UK"]},
          "category": {
            "type": "string",
            "enum": [
              "identity", "ingredients", "allergens", "nutrition", "quantity",
              "date_marking", "traceability", "business_info", "origin",
              "warnings", "presentation", "usage"
            ]
          },
          "requirement": {"type": "string"},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "source_id": {"type": "string"},
          "source_reference": {"type": "string"},
          "source_excerpt": {"type": "string"},
          "applicability": {
            "type": "object",
            "required": ["summary", "always_applies"],
            "properties": {
              "summary": {"type": "string"},
              "always_applies": {"type": "boolean"},
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["fact", "operator"],
                  "properties": {
                    "fact": {"type": "string"},
                    "operator": {"type": "string", "enum": ["is_true", "is_present", "equals", "in"]},
                    "value": {}
                  }
                }
              }
            }
          },
          "validation_type": {"type": "string", "enum": ["text", "vision", "hybrid"]},
          "required_facts": {"type": "array", "items": {"type": "string"}},
          "evidence_hint": {"type": "string"},
          "suggested_fix": {"type": "string"},
          "needs_professional_review": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
